# Доступный с Server адрес Client (DNS-имя или IPv4).
CLIENT_ADDRESS=
CLIENT_SSH_PORT=2222

# Публичный ключ, сгенерированный на Client: ssh-ed25519 AAAA...
CLIENT_HOST_PUBLIC_KEY=""

# Адрес и порт вашего приложения на Server (пример: сервис на хосте).
TARGET_HOST=host.docker.internal
TARGET_PORT=8080
