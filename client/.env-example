# SSH port on Client that Server connects to.
SSH_BIND_ADDRESS=0.0.0.0
SSH_PORT=2222

# Published port for application requests through the tunnel.
# Use 127.0.0.1 to allow access only from Client itself.
FORWARD_BIND_ADDRESS=0.0.0.0
FORWARD_PORT=18080

# Public key generated on Server: ssh-ed25519 AAAA...
SERVER_PUBLIC_KEY=""
