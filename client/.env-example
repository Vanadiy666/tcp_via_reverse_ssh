# SSH-порт Client, к которому подключается Server.
SSH_BIND_ADDRESS=0.0.0.0
SSH_PORT=2222

# Порт для запросов к приложению через туннель.
# Укажите 127.0.0.1, если доступ нужен только с самого Client.
FORWARD_BIND_ADDRESS=0.0.0.0
FORWARD_PORT=18080

# Публичный ключ, сгенерированный на Server: ssh-ed25519 AAAA...
SERVER_PUBLIC_KEY=""
